# Claude extraction via OpenRouter. Without it, the app falls back to a regex extractor (fine for the scripted demo).
OPENROUTER_API_KEY=
# Jev (TypeSafe) triage: skips posts with no closure and scores hearsay. Optional; get a key at console.typesafe.ai
TYPESAFE_API_KEY=
# Optional overrides
# TYPESAFE_MODEL=jev-latest
# OPENROUTER_MODEL=anthropic/claude-opus-5.5
# EXTRACTOR=heuristic            # force the regex extractor (offline demo)
# VALHALLA_URL=http://localhost:8002/route   # self-hosted Valhalla
